{
  "name": "freecall",
  "version": "0.0.0",
  "private": true,
  "description": "Adults-only random video chat. Monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @freecall/db",
    "db:migrate": "npm run db:migrate -w @freecall/db",
    "db:seed": "npm run db:seed -w @freecall/db",
    "secrets:check": "node scripts/check-client-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
